# Copy to .env.local and fill in. .env.local is gitignored.
#
# LOCAL DEVELOPMENT NEEDS ONLY THE FIRST TWO LINES.
# Everything below is optional until you deploy.

# --- required locally -------------------------------------------------------

# Matches docker-compose.yml. Port 5433 to avoid colliding with any other Postgres.
DATABASE_URL=postgres://survivor:localdev@localhost:5433/survivor

# Any long random string. Signs session cookies.
AUTH_SECRET=change-me-to-something-long-and-random

# --- optional locally -------------------------------------------------------

# Email. Leave unset in local dev: mail is written to ./tmp/mail as HTML files
# and the path is printed to the console, so you can read every message the app
# sends without configuring a provider or verifying a domain.
# RESEND_API_KEY=
# MAIL_FROM="Survivor League <league@example.com>"

# Odds provider (The Odds API, free Starter tier). Without it, the app uses the
# recorded fixture in src/integrations/fixtures and manual line entry still works.
# ODDS_API_KEY=

# Shared secret required by the scheduled-job endpoints, so only the cron
# trigger can invoke them. Generate a long random value before deploying.
# JOB_TRIGGER_SECRET=

# NFL schedule and scores come from ESPN's public endpoints and need no key.
